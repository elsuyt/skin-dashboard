# Copy to .env.local for local dev (`npm run dev`). In production these are
# set in the Vercel project's Environment Variables, not in this file.

# Any random string, 32+ characters. Signs the login session cookie.
SESSION_SECRET=

# The single password that gates the whole dashboard.
DASHBOARD_PASSWORD=

# Set automatically once you add the Redis integration in Vercel (Storage tab
# -> Marketplace Database Providers -> Redis). Locally, copy the values from
# your Vercel project's env vars, or run `vercel env pull .env.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
